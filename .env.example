# Supabase Postgres via PgBouncer (pooled, used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"

# Direct Supabase connection (used by Prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Ollama model server (reached via SSH tunnel in dev: localhost:11434)
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=llama3

# vLLM model server (reached via SSH tunnel in dev: localhost:8001)
VLLM_HOST=http://localhost:8001
VLLM_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3

# Mistral inference settings
MISTRAL_MAX_TOKENS=1024
MISTRAL_TEMPERATURE=0.7

# Query rewriter settings
REWRITER_MODEL=llama3
REWRITE_TIMEOUT=5000

# Streaming pacing (milliseconds)
MIN_CHUNK_DELAY=20
PER_CHAR_DELAY=2
CHUNK_DELAY_JITTER=10
CRISIS_FOLLOWUP_DELAY=45000
