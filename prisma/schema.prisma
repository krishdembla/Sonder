generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  CLINICIAN
  ADMIN
}

model Profile {
  id          String   @id
  role        Role     @default(PATIENT)
  displayName String?
  createdAt   DateTime @default(now())
}
