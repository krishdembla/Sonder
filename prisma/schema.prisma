generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  PATIENT
  CLINICIAN
  ADMIN
}

enum MessageRole {
  USER
  ASSISTANT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Profile {
  id          String   @id
  role        Role     @default(PATIENT)
  displayName String?
  createdAt   DateTime @default(now())

  conversations       Conversation[]
  assignmentsAsClinic ClinicianAssignment[] @relation("AssignedClinician")
  assignmentsAsPatien ClinicianAssignment[] @relation("AssignedPatient")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  modelId   String
  setup     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     Profile   @relation(fields: [userId], references: [id])
  messages Message[]
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  modelId        String
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model ClinicianAssignment {
  clinicianId String
  patientId   String
  createdAt   DateTime @default(now())

  clinician Profile @relation("AssignedClinician", fields: [clinicianId], references: [id])
  patient   Profile @relation("AssignedPatient", fields: [patientId], references: [id])

  @@id([clinicianId, patientId])
}
